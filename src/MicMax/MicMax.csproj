<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MicMax</RootNamespace>
    <AssemblyName>MicMax</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Single-file self-contained publish (task T044). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Application icon compiled into the executable's PE resources. -->
    <ApplicationIcon>Assets\MicMax.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded so the tray/window can load it at runtime (see AppIcon.cs). -->
    <EmbeddedResource Include="Assets\MicMax.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicMax.Core\MicMax.Core.csproj" />
  </ItemGroup>

</Project>
